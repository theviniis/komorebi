+#[cfg(test)]
+mod channel_race_diagnostic {
+    #[test]
+    fn competing_global_receiver_steals_notification() {
+        let receiver = super::event_rx();
+        let thief = std::thread::spawn(move || receiver.recv_timeout(std::time::Duration::from_secs(2)).unwrap());
+        super::send_notification(super::MonitorNotification::ResolutionScalingChanged);
+        assert_eq!(thief.join().unwrap(), super::MonitorNotification::ResolutionScalingChanged);
+        assert!(super::event_rx().try_recv().is_err(), "the test consumer has no message after the competing listener consumed it");
+    }
+}
